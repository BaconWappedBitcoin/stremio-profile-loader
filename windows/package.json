{
  "name": "stremio-profile-loader-windows",
  "version": "0.1.11",
  "description": "Profile picker that launches Stremio Web already signed in to a chosen account (Windows/desktop, Electron).",
  "main": "src/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "doctor": "node scripts/doctor.js",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.strloader",
    "productName": "STRLoader",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "../shared",
        "to": "shared"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  }
}
